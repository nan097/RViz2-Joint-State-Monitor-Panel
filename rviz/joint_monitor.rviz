Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: joint_state_rviz_panel/JointStatePanel
  Name: Joint State Monitor
  Topic: /joint_states
  Unit: deg
  FilterMode: auto
  JointNames: []
  Reliability: best_effort
  AssumeUnknownRevolute: false
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  Value: true
  Enabled: true
Window Geometry:
  Displays:
    collapsed: false
  Height: 850
  Hide Left Dock: false
  Hide Right Dock: false
  Joint State Monitor:
    collapsed: false
  QMainWindow State: 
  Width: 1200
